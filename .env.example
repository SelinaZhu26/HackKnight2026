# Set your Docker Hub namespace before publishing or pulling an image.
IMAGE_REPOSITORY=your-dockerhub-username/finapp
IMAGE_VERSION=2026.10.10-1
FINAPP_PORT=3001
# Tiger Cloud (TimescaleDB) connection string from console.cloud.timescale.com → your service → Connect.
DATABASE_URL=
# Gemini key from aistudio.google.com/apikey. Stays on the server; the site calls /api/ai/gemini.
GEMINI_API_KEY=
# ElevenLabs key (needs text_to_speech permission). Stays on the server; the site calls /api/ai/tts.
ELEVENLABS_API_KEY=
